.DS_Store
**/.DS_Store

# Local secrets. Commit .env.example files only.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# JavaScript dependencies.
**/node_modules/

# Python caches and test artifacts.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/coverage/

# Runtime data belongs outside the Skill source repository.
**/state/
**/exports/
**/reports/
**/output/
**/outputs/
**/tmp/
**/.cache/

# Local logs.
**/*.log
